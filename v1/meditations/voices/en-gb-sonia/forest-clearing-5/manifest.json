{
  "id": "forest-clearing-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 245,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.436
    },
    {
      "index": 1,
      "text": "Take a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.383
    },
    {
      "index": 2,
      "text": "Let your hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.363
    },
    {
      "index": 3,
      "text": "Allow your eyes to close, or soften your gaze.",
      "file": "c003.ogg",
      "durationSec": 5.09
    },
    {
      "index": 4,
      "text": "Notice the weight of your body being held.",
      "file": "c004.ogg",
      "durationSec": 4.513
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 3.876
    },
    {
      "index": 6,
      "text": "And a longer, easier breath out.",
      "file": "c006.ogg",
      "durationSec": 3.639
    },
    {
      "index": 7,
      "text": "Again. Soft inhale.",
      "file": "c007.ogg",
      "durationSec": 3.0
    },
    {
      "index": 8,
      "text": "Gentle exhale.",
      "file": "c008.ogg",
      "durationSec": 2.194
    },
    {
      "index": 9,
      "text": "If thoughts wander, that is fine. Return to the breath.",
      "file": "c009.ogg",
      "durationSec": 6.199
    },
    {
      "index": 10,
      "text": "Now, imagine a path beneath soft leaf litter.",
      "file": "c010.ogg",
      "durationSec": 4.919
    },
    {
      "index": 11,
      "text": "You walk without hurry into a quiet forest.",
      "file": "c011.ogg",
      "durationSec": 4.389
    },
    {
      "index": 12,
      "text": "Dappled light moves across your forearms.",
      "file": "c012.ogg",
      "durationSec": 3.761
    },
    {
      "index": 13,
      "text": "Feel the gentle warmth of the sun wherever it finds skin.",
      "file": "c013.ogg",
      "durationSec": 6.2
    },
    {
      "index": 14,
      "text": "A cool freshness rides the breeze between the trees.",
      "file": "c014.ogg",
      "durationSec": 6.023
    },
    {
      "index": 15,
      "text": "Smell green earth, bark, and a clean mineral dampness.",
      "file": "c015.ogg",
      "durationSec": 6.022
    },
    {
      "index": 16,
      "text": "The path opens into a small clearing.",
      "file": "c016.ogg",
      "durationSec": 4.279
    },
    {
      "index": 17,
      "text": "Moss cushions a fallen log. You sit.",
      "file": "c017.ogg",
      "durationSec": 3.986
    },
    {
      "index": 18,
      "text": "Sunlight pools in the center like quiet gold.",
      "file": "c018.ogg",
      "durationSec": 5.03
    },
    {
      "index": 19,
      "text": "Feel that warmth on your face, slow and kind.",
      "file": "c019.ogg",
      "durationSec": 5.04
    },
    {
      "index": 20,
      "text": "A breeze touches your hair and cools your temples.",
      "file": "c020.ogg",
      "durationSec": 5.438
    },
    {
      "index": 21,
      "text": "Birdsong arrives from far away, then fades.",
      "file": "c021.ogg",
      "durationSec": 5.03
    },
    {
      "index": 22,
      "text": "Your breath matches the hush of the leaves.",
      "file": "c022.ogg",
      "durationSec": 4.285
    },
    {
      "index": 23,
      "text": "Inhale the freshness. Exhale any leftover haste.",
      "file": "c023.ogg",
      "durationSec": 5.903
    },
    {
      "index": 24,
      "text": "Notice how safe the ground feels under you.",
      "file": "c024.ogg",
      "durationSec": 4.283
    },
    {
      "index": 25,
      "text": "How wide the sky seems above the canopy.",
      "file": "c025.ogg",
      "durationSec": 4.216
    },
    {
      "index": 26,
      "text": "A beetle crosses a sunlit patch of bark, unhurried.",
      "file": "c026.ogg",
      "durationSec": 5.495
    },
    {
      "index": 27,
      "text": "You have nowhere to be but here.",
      "file": "c027.ogg",
      "durationSec": 3.467
    },
    {
      "index": 28,
      "text": "Warmth pools again on your closed eyelids.",
      "file": "c028.ogg",
      "durationSec": 4.457
    },
    {
      "index": 29,
      "text": "Cool air slips under your collar like a kind hand.",
      "file": "c029.ogg",
      "durationSec": 5.793
    },
    {
      "index": 30,
      "text": "Stay with the warmth on your cheeks.",
      "file": "c030.ogg",
      "durationSec": 3.53
    },
    {
      "index": 31,
      "text": "Stay with the cool air on your lips as you breathe out.",
      "file": "c031.ogg",
      "durationSec": 5.565
    },
    {
      "index": 32,
      "text": "This clearing asks nothing. It simply holds you.",
      "file": "c032.ogg",
      "durationSec": 5.325
    },
    {
      "index": 33,
      "text": "Let one more breath travel all the way to the belly.",
      "file": "c033.ogg",
      "durationSec": 5.036
    },
    {
      "index": 34,
      "text": "And leave again, soft as the leaves.",
      "file": "c034.ogg",
      "durationSec": 3.866
    },
    {
      "index": 35,
      "text": "Wander your attention slowly around the clearing’s edge.",
      "file": "c035.ogg",
      "durationSec": 5.62
    },
    {
      "index": 36,
      "text": "Fern. Shadow. A pale mushroom at the base of a stump.",
      "file": "c036.ogg",
      "durationSec": 6.377
    },
    {
      "index": 37,
      "text": "Everything is vivid because you are not rushing.",
      "file": "c037.ogg",
      "durationSec": 4.689
    },
    {
      "index": 38,
      "text": "Feel sun-warmth again where it lands on the knee.",
      "file": "c038.ogg",
      "durationSec": 5.262
    },
    {
      "index": 39,
      "text": "Feel breeze-coolness where it slips across the throat.",
      "file": "c039.ogg",
      "durationSec": 5.334
    },
    {
      "index": 40,
      "text": "You could stay here all afternoon. For now, a few breaths are enough.",
      "file": "c040.ogg",
      "durationSec": 6.836
    },
    {
      "index": 41,
      "text": "Now rest in the breath alone for a little while.",
      "file": "c041.ogg",
      "durationSec": 4.284
    },
    {
      "index": 42,
      "text": "Inhale slowly.",
      "file": "c042.ogg",
      "durationSec": 2.429
    },
    {
      "index": 43,
      "text": "Exhale slowly.",
      "file": "c043.ogg",
      "durationSec": 2.311
    },
    {
      "index": 44,
      "text": "Inhale.",
      "file": "c044.ogg",
      "durationSec": 1.497
    },
    {
      "index": 45,
      "text": "Exhale.",
      "file": "c045.ogg",
      "durationSec": 1.495
    },
    {
      "index": 46,
      "text": "Feel warmth wherever the body is warm.",
      "file": "c046.ogg",
      "durationSec": 4.335
    },
    {
      "index": 47,
      "text": "Feel coolness wherever the air is cool.",
      "file": "c047.ogg",
      "durationSec": 3.99
    },
    {
      "index": 48,
      "text": "Inhale.",
      "file": "c048.ogg",
      "durationSec": 1.488
    },
    {
      "index": 49,
      "text": "Exhale.",
      "file": "c049.ogg",
      "durationSec": 1.661
    },
    {
      "index": 50,
      "text": "Nowhere to go. Nothing to fix.",
      "file": "c050.ogg",
      "durationSec": 3.287
    },
    {
      "index": 51,
      "text": "Inhale.",
      "file": "c051.ogg",
      "durationSec": 1.555
    },
    {
      "index": 52,
      "text": "Exhale.",
      "file": "c052.ogg",
      "durationSec": 1.485
    },
    {
      "index": 53,
      "text": "Rest here for a few quiet breaths.",
      "file": "c053.ogg",
      "durationSec": 3.923
    },
    {
      "index": 54,
      "text": "Know that you can return to this place anytime.",
      "file": "c054.ogg",
      "durationSec": 4.974
    },
    {
      "index": 55,
      "text": "When you are ready, deepen the breath.",
      "file": "c055.ogg",
      "durationSec": 4.047
    },
    {
      "index": 56,
      "text": "Wiggle fingers and toes.",
      "file": "c056.ogg",
      "durationSec": 2.594
    },
    {
      "index": 57,
      "text": "Open your eyes softly.",
      "file": "c057.ogg",
      "durationSec": 2.766
    },
    {
      "index": 58,
      "text": "Carry a little of this peace with you.",
      "file": "c058.ogg",
      "durationSec": 3.581
    }
  ],
