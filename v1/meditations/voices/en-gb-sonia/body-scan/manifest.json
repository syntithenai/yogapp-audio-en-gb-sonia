{
  "id": "body-scan",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 91,
  "chunks": [
    {
      "index": 0,
      "text": "We will gently scan the body.",
      "file": "c000.ogg",
      "durationSec": 3.199
    },
    {
      "index": 1,
      "text": "Lie down or sit with ease.",
      "file": "c001.ogg",
      "durationSec": 3.003
    },
    {
      "index": 2,
      "text": "Close your eyes if that feels safe.",
      "file": "c002.ogg",
      "durationSec": 3.354
    },
    {
      "index": 3,
      "text": "Begin at the crown of the head.",
      "file": "c003.ogg",
      "durationSec": 3.236
    },
    {
      "index": 4,
      "text": "Notice any sensation there. Warmth. Coolness. Nothing at all.",
      "file": "c004.ogg",
      "durationSec": 7.421
    },
    {
      "index": 5,
      "text": "No need to change it. Just notice.",
      "file": "c005.ogg",
      "durationSec": 3.701
    },
    {
      "index": 6,
      "text": "Softly move to the forehead and the eyes.",
      "file": "c006.ogg",
      "durationSec": 4.563
    },
    {
      "index": 7,
      "text": "Let the tiny muscles around the eyes soften.",
      "file": "c007.ogg",
      "durationSec": 4.286
    },
    {
      "index": 8,
      "text": "Feel the jaw. Unclench if you can.",
      "file": "c008.ogg",
      "durationSec": 3.993
    },
    {
      "index": 9,
      "text": "Tongue resting lightly.",
      "file": "c009.ogg",
      "durationSec": 2.478
    },
    {
      "index": 10,
      "text": "Shoulders. Are they lifted? Let them drop a little.",
      "file": "c010.ogg",
      "durationSec": 6.255
    },
    {
      "index": 11,
      "text": "Arms heavy. Hands open or soft.",
      "file": "c011.ogg",
      "durationSec": 4.047
    },
    {
      "index": 12,
      "text": "Chest rising and falling with breath.",
      "file": "c012.ogg",
      "durationSec": 3.582
    },
    {
      "index": 13,
      "text": "Belly soft. No forcing.",
      "file": "c013.ogg",
      "durationSec": 3.007
    },
    {
      "index": 14,
      "text": "Hips and pelvis resting.",
      "file": "c014.ogg",
      "durationSec": 2.593
    },
    {
      "index": 15,
      "text": "Thighs. Knees. Lower legs.",
      "file": "c015.ogg",
      "durationSec": 3.24
    },
    {
      "index": 16,
      "text": "Feet. Soles touching the floor or the mat.",
      "file": "c016.ogg",
      "durationSec": 5.091
    },
    {
      "index": 17,
      "text": "Now sense the whole body as one field of awareness.",
      "file": "c017.ogg",
      "durationSec": 5.494
    },
    {
      "index": 18,
      "text": "Breath moving through it.",
      "file": "c018.ogg",
      "durationSec": 2.363
    },
    {
      "index": 19,
      "text": "If a tense spot appears, send a kind exhale there.",
      "file": "c019.ogg",
      "durationSec": 5.269
    },
    {
      "index": 20,
      "text": "Stay for three quiet breaths.",
      "file": "c020.ogg",
      "durationSec": 2.937
    },
    {
      "index": 21,
      "text": "When you are ready, wiggle fingers and toes.",
      "file": "c021.ogg",
      "durationSec": 4.338
    },
    {
      "index": 22,
      "text": "Open your eyes. Return gently.",
      "file": "c022.ogg",
      "durationSec": 3.876
    }
  ],
