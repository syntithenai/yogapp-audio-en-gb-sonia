  "totalSec": 574,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.374
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 2.599
    },
    {
      "index": 2,
      "text": "Sit or lie down with support.",
      "file": "c002.ogg",
      "durationSec": 3.298
    },
    {
      "index": 3,
      "text": "Close the eyes if that feels safe.",
      "file": "c003.ogg",
      "durationSec": 3.527
    },
    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 3.178
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.197
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
      "durationSec": 2.252
    },
    {
      "index": 7,
      "text": "[pause:27]",
      "file": "c007.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 1.32
    },
    {
      "index": 9,
      "text": "[pause:27]",
      "file": "c009.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 2.542
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
      "durationSec": 2.546
    },
    {
      "index": 12,
      "text": "[pause:34]",
      "file": "c012.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Begin with one small concrete good.",
      "file": "c013.ogg",
      "durationSec": 4.103
    },
    {
      "index": 14,
      "text": "Hold it. Thank it.",
      "file": "c014.ogg",
      "durationSec": 2.251
    },
    {
      "index": 15,
      "text": "[pause:40]",
      "file": "c015.ogg",
      "durationSec": 40.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "A second. A person, place, or comfort.",
      "file": "c016.ogg",
      "durationSec": 4.507
    },
    {
      "index": 17,
      "text": "Thank you.",
      "file": "c017.ogg",
      "durationSec": 1.546
    },
    {
      "index": 18,
      "text": "[pause:40]",
      "file": "c018.ogg",
      "durationSec": 40.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "A third. Something about your body that works today.",
      "file": "c019.ogg",
      "durationSec": 5.73
    },
    {
      "index": 20,
      "text": "Thank you.",
      "file": "c020.ogg",
      "durationSec": 1.555
    },
    {
      "index": 21,
      "text": "[pause:40]",
      "file": "c021.ogg",
      "durationSec": 40.0,
      "silence": true
    },
    {
      "index": 22,
      "text": "Widen to the people who have been kind, even briefly.",
      "file": "c022.ogg",
      "durationSec": 5.85
    },
    {
      "index": 23,
      "text": "[pause:54]",
      "file": "c023.ogg",
      "durationSec": 54.0,
      "silence": true
    },
    {
      "index": 24,
      "text": "Widen to the place you are in. Shelter. Air. Ground.",
      "file": "c024.ogg",
      "durationSec": 7.472
    },
    {
      "index": 25,
      "text": "[pause:54]",
      "file": "c025.ogg",
      "durationSec": 54.0,
      "silence": true
    },
    {
      "index": 26,
      "text": "If gratitude feels hard, thank the effort of showing up.",
      "file": "c026.ogg",
      "durationSec": 6.49
    },
    {
      "index": 27,
      "text": "That counts.",
      "file": "c027.ogg",
      "durationSec": 1.836
    },
    {
      "index": 28,
      "text": "[pause:40]",
      "file": "c028.ogg",
      "durationSec": 40.0,
      "silence": true
    },
    {
      "index": 29,
      "text": "Rest in any warmth that arose.",
      "file": "c029.ogg",
      "durationSec": 3.823
    },
    {
      "index": 30,
      "text": "Or rest in the intention itself.",
      "file": "c030.ogg",
      "durationSec": 3.755
    },
    {
      "index": 31,
      "text": "[pause:90]",
      "file": "c031.ogg",
      "durationSec": 90.0,
      "silence": true
    },
    {
      "index": 32,
      "text": "[pause:40]",
      "file": "c032.ogg",
      "durationSec": 40.0,
      "silence": true
    },
    {
      "index": 33,
      "text": "Begin to deepen the breath.",
      "file": "c033.ogg",
      "durationSec": 2.542
    },
    {
      "index": 34,
      "text": "Feel the room again.",
      "file": "c034.ogg",
      "durationSec": 2.477
    },
    {
      "index": 35,
      "text": "Wiggle fingers and toes.",
      "file": "c035.ogg",
      "durationSec": 2.707
    },
    {
      "index": 36,
      "text": "When ready, open the eyes.",
      "file": "c036.ogg",
      "durationSec": 2.43
    },
    {
      "index": 37,
      "text": "Move slowly into what comes next.",
      "file": "c037.ogg",
      "durationSec": 4.108
    }
  ],
