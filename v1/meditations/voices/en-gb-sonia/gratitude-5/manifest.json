{
  "id": "gratitude-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 284,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.43
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.436
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.6
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.529
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.716
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.478
    },
    {
      "index": 6,
      "text": "Bring to mind one small thing that helped you today, or this week.",
      "file": "c006.ogg",
      "durationSec": 7.358
    },
    {
      "index": 7,
      "text": "It can be ordinary. Warm water. A message. Light on a wall.",
      "file": "c007.ogg",
      "durationSec": 7.47
    },
    {
      "index": 8,
      "text": "[pause:21]",
      "file": "c008.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 9,
      "text": "Hold it gently in awareness.",
      "file": "c009.ogg",
      "durationSec": 3.062
    },
    {
      "index": 10,
      "text": "Notice any softening in the chest or face.",
      "file": "c010.ogg",
      "durationSec": 4.267
    },
    {
      "index": 11,
      "text": "[pause:26]",
      "file": "c011.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 12,
      "text": "Silently, thank this one thing.",
      "file": "c012.ogg",
      "durationSec": 3.474
    },
    {
      "index": 13,
      "text": "Thank you for being here.",
      "file": "c013.ogg",
      "durationSec": 2.596
    },
    {
      "index": 14,
      "text": "[pause:21]",
      "file": "c014.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 15,
      "text": "Now a second thing. Another small good.",
      "file": "c015.ogg",
      "durationSec": 4.287
    },
    {
      "index": 16,
      "text": "[pause:26]",
      "file": "c016.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Thank you.",
      "file": "c017.ogg",
      "durationSec": 1.435
    },
    {
      "index": 18,
      "text": "[pause:15]",
      "file": "c018.ogg",
      "durationSec": 15.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "And one more. A third.",
      "file": "c019.ogg",
      "durationSec": 2.893
    },
    {
      "index": 20,
      "text": "[pause:26]",
      "file": "c020.ogg",
      "durationSec": 26.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Let gratitude be simple. Not forced. Just noticed.",
      "file": "c021.ogg",
      "durationSec": 5.563
    },
    {
      "index": 22,
      "text": "[pause:31]",
      "file": "c022.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Rest in that warmth for a few breaths.",
      "file": "c023.ogg",
      "durationSec": 3.706
    },
    {
      "index": 24,
      "text": "[pause:41]",
      "file": "c024.ogg",
      "durationSec": 41.0,
      "silence": true
    },
    {
      "index": 25,
      "text": "Take one more easy breath.",
      "file": "c025.ogg",
      "durationSec": 2.654
    },
    {
      "index": 26,
      "text": "Wiggle the fingers.",
      "file": "c026.ogg",
      "durationSec": 2.195
    },
    {
      "index": 27,
      "text": "When you are ready, open the eyes.",
      "file": "c027.ogg",
      "durationSec": 4.455
    },
    {
      "index": 28,
      "text": "Carry a little of this with you.",
      "file": "c028.ogg",
      "durationSec": 3.056
    }
  ],
