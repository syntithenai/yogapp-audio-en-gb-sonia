{
  "id": "garden-dusk-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 225,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.381
    },
    {
      "index": 1,
      "text": "Take a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.792
    },
    {
      "index": 2,
      "text": "Let your hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.429
    },
    {
      "index": 3,
      "text": "Allow your eyes to close, or soften your gaze.",
      "file": "c003.ogg",
      "durationSec": 5.088
    },
    {
      "index": 4,
      "text": "Notice the weight of your body being held.",
      "file": "c004.ogg",
      "durationSec": 4.11
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 3.87
    },
    {
      "index": 6,
      "text": "And a longer, easier breath out.",
      "file": "c006.ogg",
      "durationSec": 3.698
    },
    {
      "index": 7,
      "text": "Again. Soft inhale.",
      "file": "c007.ogg",
      "durationSec": 3.355
    },
    {
      "index": 8,
      "text": "Gentle exhale.",
      "file": "c008.ogg",
      "durationSec": 2.197
    },
    {
      "index": 9,
      "text": "If thoughts wander, that is fine. Return to the breath.",
      "file": "c009.ogg",
      "durationSec": 5.726
    },
    {
      "index": 10,
      "text": "Imagine a quiet walled garden at soft dusk.",
      "file": "c010.ogg",
      "durationSec": 5.033
    },
    {
      "index": 11,
      "text": "Stone paths hold the last warmth of the day.",
      "file": "c011.ogg",
      "durationSec": 5.262
    },
    {
      "index": 12,
      "text": "Feel that gentle heat through the soles of your feet.",
      "file": "c012.ogg",
      "durationSec": 5.438
    },
    {
      "index": 13,
      "text": "Lavender and evening roses release a calm fragrance.",
      "file": "c013.ogg",
      "durationSec": 5.842
    },
    {
      "index": 14,
      "text": "A cool breeze slips over the wall and cools your neck.",
      "file": "c014.ogg",
      "durationSec": 5.842
    },
    {
      "index": 15,
      "text": "The air is fresh after a warm afternoon.",
      "file": "c015.ogg",
      "durationSec": 4.285
    },
    {
      "index": 16,
      "text": "You walk slowly between hedges trimmed soft as breath.",
      "file": "c016.ogg",
      "durationSec": 5.729
    },
    {
      "index": 17,
      "text": "Your fingers brush leaves still holding sun.",
      "file": "c017.ogg",
      "durationSec": 4.636
    },
    {
      "index": 18,
      "text": "Warm. Smooth. Alive.",
      "file": "c018.ogg",
      "durationSec": 3.756
    },
    {
      "index": 19,
      "text": "A wooden bench waits beneath a quiet tree.",
      "file": "c019.ogg",
      "durationSec": 4.515
    },
    {
      "index": 20,
      "text": "You sit. The wood is pleasantly warm against your back.",
      "file": "c020.ogg",
      "durationSec": 6.255
    },
    {
      "index": 21,
      "text": "Above, the sky turns lavender and rose.",
      "file": "c021.ogg",
      "durationSec": 4.456
    },
    {
      "index": 22,
      "text": "Birds settle. The garden grows hush.",
      "file": "c022.ogg",
      "durationSec": 4.631
    },
    {
      "index": 23,
      "text": "Feel warmth fading kindly from stone and wood.",
      "file": "c023.ogg",
      "durationSec": 5.039
    },
    {
      "index": 24,
      "text": "Feel the freshening cool of evening on your face.",
      "file": "c024.ogg",
      "durationSec": 5.215
    },
    {
      "index": 25,
      "text": "Inhale scent and stillness.",
      "file": "c025.ogg",
      "durationSec": 3.529
    },
    {
      "index": 26,
      "text": "Exhale the day you carried in.",
      "file": "c026.ogg",
      "durationSec": 3.354
    },
    {
      "index": 27,
      "text": "A moth passes through the last gold light.",
      "file": "c027.ogg",
      "durationSec": 4.17
    },
    {
      "index": 28,
      "text": "Nothing here is urgent. Everything is enough.",
      "file": "c028.ogg",
      "durationSec": 4.109
    },
    {
      "index": 29,
      "text": "Rest in that enoughness.",
      "file": "c029.ogg",
      "durationSec": 2.486
    },
    {
      "index": 30,
      "text": "Let your belly soften into the dusk air.",
      "file": "c030.ogg",
      "durationSec": 4.223
    },
    {
      "index": 31,
      "text": "Let your next breath be the quietest of the day.",
      "file": "c031.ogg",
      "durationSec": 5.092
    },
    {
      "index": 32,
      "text": "Walk one slow loop of the path before you finish.",
      "file": "c032.ogg",
      "durationSec": 5.444
    },
    {
      "index": 33,
      "text": "Warm stones cooling underfoot.",
      "file": "c033.ogg",
      "durationSec": 3.405
    },
    {
      "index": 34,
      "text": "Hedges releasing the day’s stored perfume.",
      "file": "c034.ogg",
      "durationSec": 4.282
    },
    {
      "index": 35,
      "text": "The breeze now has an evening edge — fresh, almost sweet.",
      "file": "c035.ogg",
      "durationSec": 6.026
    },
    {
      "index": 36,
      "text": "Pause at the gate without opening it yet.",
      "file": "c036.ogg",
      "durationSec": 3.597
    },
    {
      "index": 37,
      "text": "Feel how calm has settled into the shoulders.",
      "file": "c037.ogg",
      "durationSec": 4.455
    },
    {
      "index": 38,
      "text": "Carry the garden’s hush like a small lantern inward.",
      "file": "c038.ogg",
      "durationSec": 6.084
    },
    {
      "index": 39,
      "text": "Now rest in the breath alone for a little while.",
      "file": "c039.ogg",
      "durationSec": 4.519
    },
    {
      "index": 40,
      "text": "Inhale slowly.",
      "file": "c040.ogg",
      "durationSec": 2.501
    },
    {
      "index": 41,
      "text": "Exhale slowly.",
      "file": "c041.ogg",
      "durationSec": 2.248
    },
    {
      "index": 42,
      "text": "Inhale.",
      "file": "c042.ogg",
      "durationSec": 1.668
    },
    {
      "index": 43,
      "text": "Exhale.",
      "file": "c043.ogg",
      "durationSec": 1.664
    },
    {
      "index": 44,
      "text": "Feel warmth wherever the body is warm.",
      "file": "c044.ogg",
      "durationSec": 4.054
    },
    {
      "index": 45,
      "text": "Feel coolness wherever the air is cool.",
      "file": "c045.ogg",
      "durationSec": 4.343
    },
    {
      "index": 46,
      "text": "Inhale.",
      "file": "c046.ogg",
      "durationSec": 1.611
    },
    {
      "index": 47,
      "text": "Exhale.",
      "file": "c047.ogg",
      "durationSec": 1.433
    },
    {
      "index": 48,
      "text": "Nowhere to go. Nothing to fix.",
      "file": "c048.ogg",
      "durationSec": 3.347
    },
    {
      "index": 49,
      "text": "Inhale.",
      "file": "c049.ogg",
      "durationSec": 1.486
    },
    {
      "index": 50,
      "text": "Exhale.",
      "file": "c050.ogg",
      "durationSec": 1.549
    },
    {
      "index": 51,
      "text": "Rest here for a few quiet breaths.",
      "file": "c051.ogg",
      "durationSec": 3.411
    },
    {
      "index": 52,
      "text": "Know that you can return to this place anytime.",
      "file": "c052.ogg",
      "durationSec": 4.916
    },
    {
      "index": 53,
      "text": "When you are ready, deepen the breath.",
      "file": "c053.ogg",
      "durationSec": 3.939
    },
    {
      "index": 54,
      "text": "Wiggle fingers and toes.",
      "file": "c054.ogg",
      "durationSec": 2.482
    },
    {
      "index": 55,
      "text": "Open your eyes softly.",
      "file": "c055.ogg",
      "durationSec": 2.539
    },
    {
      "index": 56,
      "text": "Carry a little of this peace with you.",
      "file": "c056.ogg",
      "durationSec": 3.59
    }
  ],
