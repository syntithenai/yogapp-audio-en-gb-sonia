  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.314
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 2.545
    },
    {
      "index": 2,
      "text": "Sit or lie down with support.",
      "file": "c002.ogg",
      "durationSec": 2.83
    },
    {
      "index": 3,
      "text": "Close the eyes if that feels safe.",
      "file": "c003.ogg",
      "durationSec": 3.588
    },
    {
      "index": 4,
      "text": "Feel contact with the ground.",
      "file": "c004.ogg",
      "durationSec": 3.062
    },
    {
      "index": 5,
      "text": "Slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.065
    },
    {
      "index": 6,
      "text": "Longer breath out.",
      "file": "c006.ogg",
      "durationSec": 2.367
    },
    {
      "index": 7,
      "text": "[pause:21]",
      "file": "c007.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Again.",
      "file": "c008.ogg",
      "durationSec": 1.318
    },
    {
      "index": 9,
      "text": "[pause:21]",
      "file": "c009.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Let the shoulders drop.",
      "file": "c010.ogg",
      "durationSec": 2.485
    },
    {
      "index": 11,
      "text": "Let the belly soften.",
      "file": "c011.ogg",
      "durationSec": 2.596
    },
    {
      "index": 12,
      "text": "[pause:27]",
      "file": "c012.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Begin at the crown of the head.",
      "file": "c013.ogg",
      "durationSec": 3.197
    },
    {
      "index": 14,
      "text": "Notice sensation, or the lack of it.",
      "file": "c014.ogg",
      "durationSec": 3.59
    },
    {
      "index": 15,
      "text": "[pause:27]",
      "file": "c015.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Forehead. Eyes. Cheeks. Jaw.",
      "file": "c016.ogg",
      "durationSec": 3.351
    },
    {
      "index": 17,
      "text": "Let the face melt a little.",
      "file": "c017.ogg",
      "durationSec": 2.829
    },
    {
      "index": 18,
      "text": "[pause:27]",
      "file": "c018.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "Throat. Neck. Shoulders.",
      "file": "c019.ogg",
      "durationSec": 2.71
    },
    {
      "index": 20,
      "text": "Invite the shoulders to drop.",
      "file": "c020.ogg",
      "durationSec": 3.295
    },
    {
      "index": 21,
      "text": "[pause:32]",
      "file": "c021.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 22,
      "text": "Arms. Elbows. Wrists. Hands. Fingers.",
      "file": "c022.ogg",
      "durationSec": 4.277
    },
    {
      "index": 23,
      "text": "[pause:32]",
      "file": "c023.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 24,
      "text": "Chest rising and falling.",
      "file": "c024.ogg",
      "durationSec": 2.475
    },
    {
      "index": 25,
      "text": "Heart space soft.",
      "file": "c025.ogg",
      "durationSec": 2.415
    },
    {
      "index": 26,
      "text": "[pause:27]",
      "file": "c026.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 27,
      "text": "Belly. Low back. Hips.",
      "file": "c027.ogg",
      "durationSec": 2.895
    },
    {
      "index": 28,
      "text": "[pause:32]",
      "file": "c028.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 29,
      "text": "Thighs. Knees. Calves. Ankles. Feet. Toes.",
      "file": "c029.ogg",
      "durationSec": 5.27
    },
    {
      "index": 30,
      "text": "[pause:38]",
      "file": "c030.ogg",
      "durationSec": 38.0,
      "silence": true
    },
    {
      "index": 31,
      "text": "Sense the whole body as one field.",
      "file": "c031.ogg",
      "durationSec": 3.876
    },
    {
      "index": 32,
      "text": "Breath moving through it.",
      "file": "c032.ogg",
      "durationSec": 2.255
    },
    {
      "index": 33,
      "text": "[pause:54]",
      "file": "c033.ogg",
      "durationSec": 54.0,
      "silence": true
    },
    {
      "index": 34,
      "text": "If a tense place remains, send an exhale there.",
      "file": "c034.ogg",
      "durationSec": 5.211
    },
    {
      "index": 35,
      "text": "[pause:43]",
      "file": "c035.ogg",
      "durationSec": 43.0,
      "silence": true
    },
    {
      "index": 36,
      "text": "Rest in whole-body awareness.",
      "file": "c036.ogg",
      "durationSec": 3.241
    },
    {
      "index": 37,
      "text": "[pause:81]",
      "file": "c037.ogg",
      "durationSec": 81.0,
      "silence": true
    },
    {
      "index": 38,
      "text": "[pause:32]",
      "file": "c038.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 39,
      "text": "Begin to deepen the breath.",
      "file": "c039.ogg",
      "durationSec": 2.893
    },
    {
      "index": 40,
      "text": "Feel the room again.",
      "file": "c040.ogg",
      "durationSec": 2.428
    },
    {
      "index": 41,
      "text": "Wiggle fingers and toes.",
