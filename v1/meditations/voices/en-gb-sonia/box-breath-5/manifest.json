      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.38
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.498
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.543
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.412
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.596
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.479
    },
    {
      "index": 6,
      "text": "We will breathe in a simple box.",
      "file": "c006.ogg",
      "durationSec": 3.592
    },
    {
      "index": 7,
      "text": "In for four. Hold for four. Out for four. Hold for four.",
      "file": "c007.ogg",
      "durationSec": 8.237
    },
    {
      "index": 8,
      "text": "Stay gentle. Never strain.",
      "file": "c008.ogg",
      "durationSec": 3.013
    },
    {
      "index": 9,
      "text": "[pause:20]",
      "file": "c009.ogg",
      "durationSec": 20.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Inhale. Two. Three. Four.",
      "file": "c010.ogg",
      "durationSec": 4.746
    },
    {
      "index": 11,
      "text": "Hold. Two. Three. Four.",
      "file": "c011.ogg",
      "durationSec": 2.714
    },
    {
      "index": 12,
      "text": "Exhale. Two. Three. Four.",
      "file": "c012.ogg",
      "durationSec": 3.64
