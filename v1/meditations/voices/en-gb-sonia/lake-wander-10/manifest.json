{
  "id": "lake-wander-10",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 437,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.378
    },
    {
      "index": 1,
      "text": "Find a posture that asks nothing of you.",
      "file": "c001.ogg",
      "durationSec": 3.986
    },
    {
      "index": 2,
      "text": "Sit, or lie down, with whatever support you need.",
      "file": "c002.ogg",
      "durationSec": 5.439
    },
    {
      "index": 3,
      "text": "Let your hands rest open or soft.",
      "file": "c003.ogg",
      "durationSec": 3.936
    },
    {
      "index": 4,
      "text": "Allow your eyes to close, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 4.969
    },
    {
      "index": 5,
      "text": "Feel the places where your body meets the ground.",
      "file": "c005.ogg",
      "durationSec": 5.034
    },
    {
      "index": 6,
      "text": "The heels, the sit bones, the back of the head, or the length of the spine.",
      "file": "c006.ogg",
      "durationSec": 7.239
    },
    {
      "index": 7,
      "text": "Nothing to hold up right now.",
      "file": "c007.ogg",
      "durationSec": 2.544
    },
    {
      "index": 8,
      "text": "Take a slow breath in through the nose.",
      "file": "c008.ogg",
      "durationSec": 3.989
    },
    {
      "index": 9,
      "text": "Feel the coolness of the air arriving.",
      "file": "c009.ogg",
      "durationSec": 3.935
    },
    {
      "index": 10,
      "text": "And breathe out a little longer.",
      "file": "c010.ogg",
      "durationSec": 3.066
    },
    {
      "index": 11,
      "text": "Feel the warmth of the exhale leaving.",
      "file": "c011.ogg",
      "durationSec": 4.449
    },
    {
      "index": 12,
      "text": "Again. Soft inhale.",
      "file": "c012.ogg",
      "durationSec": 3.011
    },
    {
      "index": 13,
      "text": "Unhurried exhale.",
      "file": "c013.ogg",
      "durationSec": 2.362
    },
    {
      "index": 14,
      "text": "Let the shoulders drop a fraction.",
      "file": "c014.ogg",
      "durationSec": 3.474
    },
    {
      "index": 15,
      "text": "Let the jaw unclench.",
      "file": "c015.ogg",
      "durationSec": 2.715
    },
    {
      "index": 16,
      "text": "Let the belly be soft.",
      "file": "c016.ogg",
      "durationSec": 2.426
    },
    {
      "index": 17,
      "text": "Stay with three quiet breaths, just as they are.",
      "file": "c017.ogg",
      "durationSec": 5.212
    },
    {
      "index": 18,
      "text": "Inhale. Arrive.",
      "file": "c018.ogg",
      "durationSec": 3.294
    },
    {
      "index": 19,
      "text": "Exhale. Settle.",
      "file": "c019.ogg",
      "durationSec": 2.769
    },
    {
      "index": 20,
      "text": "If the mind wanders, notice it kindly, and come back to this breath.",
      "file": "c020.ogg",
      "durationSec": 7.651
    },
    {
      "index": 21,
      "text": "Imagine waking beside a wide quiet lake.",
      "file": "c021.ogg",
      "durationSec": 4.806
    },
    {
      "index": 22,
      "text": "Morning light lies soft on the water.",
      "file": "c022.ogg",
      "durationSec": 3.992
    },
    {
      "index": 23,
      "text": "Cool air touches your cheeks with a clean freshness.",
      "file": "c023.ogg",
      "durationSec": 5.316
    },
    {
      "index": 24,
      "text": "The first sun warms the tops of your feet.",
      "file": "c024.ogg",
      "durationSec": 4.392
    },
    {
      "index": 25,
      "text": "You begin a slow walk along the shore.",
      "file": "c025.ogg",
      "durationSec": 3.985
    },
    {
      "index": 26,
      "text": "Sand and small smooth stones shift gently underfoot.",
      "file": "c026.ogg",
      "durationSec": 5.734
    },
    {
      "index": 27,
      "text": "Each step is a quiet conversation with the ground.",
      "file": "c027.ogg",
      "durationSec": 5.849
    },
    {
      "index": 28,
      "text": "A breeze comes off the water — fresh, lightly cool.",
      "file": "c028.ogg",
      "durationSec": 5.795
    },
    {
      "index": 29,
      "text": "It lifts the hair at your temples.",
      "file": "c029.ogg",
      "durationSec": 3.637
    },
    {
      "index": 30,
      "text": "Smell cedar, wet stones, and open morning.",
      "file": "c030.ogg",
      "durationSec": 4.683
    },
    {
      "index": 31,
      "text": "Watch a heron stand in the shallows, perfectly still.",
      "file": "c031.ogg",
      "durationSec": 5.681
    },
    {
      "index": 32,
      "text": "You match that stillness for a few breaths.",
      "file": "c032.ogg",
      "durationSec": 4.397
    },
    {
      "index": 33,
      "text": "Warmth grows on your shoulders as the sun climbs.",
      "file": "c033.ogg",
      "durationSec": 5.334
    },
    {
      "index": 34,
      "text": "Find a sunlit boulder and sit.",
      "file": "c034.ogg",
      "durationSec": 3.236
    },
    {
      "index": 35,
      "text": "Feel heat stored in the stone rising into your body.",
      "file": "c035.ogg",
      "durationSec": 5.613
    },
    {
      "index": 36,
      "text": "Feel the fresher air moving across your lips with each inhale.",
      "file": "c036.ogg",
      "durationSec": 6.896
    },
    {
      "index": 37,
      "text": "The lake’s surface wrinkles, then goes glass again.",
      "file": "c037.ogg",
      "durationSec": 4.916
    },
    {
      "index": 38,
      "text": "Light trembles there like quiet joy.",
      "file": "c038.ogg",
      "durationSec": 4.111
    },
    {
      "index": 39,
      "text": "Continue around a curve of shore into a little bay.",
      "file": "c039.ogg",
      "durationSec": 5.564
    },
    {
      "index": 40,
      "text": "Reeds whisper. Water ticks softly against wood.",
      "file": "c040.ogg",
      "durationSec": 5.327
    },
    {
      "index": 41,
      "text": "An old dock stretches out. You walk to the end.",
      "file": "c041.ogg",
      "durationSec": 5.45
    },
    {
      "index": 42,
      "text": "Sit with feet dangling above cool water.",
      "file": "c042.ogg",
      "durationSec": 4.735
    },
    {
      "index": 43,
      "text": "Sun on your back. Breeze on your shins.",
      "file": "c043.ogg",
      "durationSec": 4.504
    },
    {
      "index": 44,
      "text": "Dip a toe. Gentle chill. A smile you do not need to show.",
      "file": "c044.ogg",
      "durationSec": 7.124
    },
    {
      "index": 45,
      "text": "Lie back on the warm boards.",
      "file": "c045.ogg",
      "durationSec": 2.708
    },
    {
      "index": 46,
      "text": "Hear water under you. Sky above you.",
      "file": "c046.ogg",
      "durationSec": 4.62
    },
    {
      "index": 47,
      "text": "Your breath becomes as wide as the lake.",
      "file": "c047.ogg",
      "durationSec": 4.046
    },
    {
      "index": 48,
      "text": "Inhale freshness. Exhale into endless blue.",
      "file": "c048.ogg",
      "durationSec": 5.964
    },
    {
      "index": 49,
      "text": "Nothing to solve. Only this warmth, this air, this peace.",
      "file": "c049.ogg",
      "durationSec": 6.49
    },
    {
      "index": 50,
      "text": "Feel the dock’s heat along your spine.",
      "file": "c050.ogg",
      "durationSec": 3.935
    },
    {
      "index": 51,
      "text": "Feel a cooler ribbon of air whenever the breeze turns.",
      "file": "c051.ogg",
      "durationSec": 5.15
    },
    {
      "index": 52,
      "text": "A dragonfly stitches the air and is gone.",
      "file": "c052.ogg",
      "durationSec": 3.823
    },
    {
      "index": 53,
      "text": "Stay until the feeling sinks into muscle and bone.",
      "file": "c053.ogg",
      "durationSec": 5.215
    },
    {
      "index": 54,
      "text": "If the mind lists tasks, set them on the far shore for now.",
      "file": "c054.ogg",
      "durationSec": 6.607
    },
    {
      "index": 55,
      "text": "They can wait. The lake is not waiting for anything.",
      "file": "c055.ogg",
      "durationSec": 5.502
    },
    {
      "index": 56,
      "text": "One hand on the belly. Rise. Fall.",
      "file": "c056.ogg",
      "durationSec": 4.34
    },
    {
      "index": 57,
      "text": "Warmth under the palm of the other hand on wood.",
      "file": "c057.ogg",
      "durationSec": 5.378
    },
    {
      "index": 58,
      "text": "Rest in this double holding — body and place.",
      "file": "c058.ogg",
      "durationSec": 5.377
    },
    {
      "index": 59,
      "text": "Stand and walk a little farther in imagination.",
      "file": "c059.ogg",
      "durationSec": 4.74
    },
    {
      "index": 60,
      "text": "Pebbles click softly. Water brightens near a fallen branch.",
      "file": "c060.ogg",
      "durationSec": 6.71
    },
    {
      "index": 61,
      "text": "Sun finds the back of your neck with friendly heat.",
      "file": "c061.ogg",
      "durationSec": 5.264
    },
    {
      "index": 62,
      "text": "Shade from a willow cools your eyelids for a few steps.",
      "file": "c062.ogg",
      "durationSec": 5.563
    },
    {
      "index": 63,
      "text": "Alternating warmth and freshness becomes a walking prayer.",
      "file": "c063.ogg",
      "durationSec": 6.024
    },
    {
      "index": 64,
      "text": "No words required. Only sensation and breath.",
      "file": "c064.ogg",
      "durationSec": 5.263
    },
    {
      "index": 65,
      "text": "Find a patch of warm sand and sit facing open water.",
      "file": "c065.ogg",
      "durationSec": 5.556
    },
    {
      "index": 66,
      "text": "Let the eyes go soft on the horizon line.",
      "file": "c066.ogg",
      "durationSec": 4.513
    },
    {
      "index": 67,
      "text": "Inhale the lake’s cool perfume.",
      "file": "c067.ogg",
      "durationSec": 3.877
    },
    {
      "index": 68,
      "text": "Exhale toward the distant hills.",
      "file": "c068.ogg",
      "durationSec": 3.824
    },
    {
      "index": 69,
      "text": "Whatever you carried here can rest on the shore beside you.",
      "file": "c069.ogg",
      "durationSec": 5.333
    },
    {
      "index": 70,
      "text": "It does not need carrying in the water.",
      "file": "c070.ogg",
      "durationSec": 4.341
    },
    {
      "index": 71,
      "text": "Stay until the next three breaths feel complete on their own.",
      "file": "c071.ogg",
      "durationSec": 5.963
    },
    {
      "index": 72,
      "text": "Now let the story rest, and stay with sensation.",
      "file": "c072.ogg",
      "durationSec": 5.037
    },
    {
      "index": 73,
      "text": "Inhale the freshness of this place.",
      "file": "c073.ogg",
      "durationSec": 3.76
    },
    {
      "index": 74,
      "text": "Exhale into its warmth and quiet.",
      "file": "c074.ogg",
      "durationSec": 3.936
    },
    {
      "index": 75,
      "text": "Inhale.",
      "file": "c075.ogg",
      "durationSec": 1.611
    },
    {
      "index": 76,
      "text": "Exhale.",
      "file": "c076.ogg",
      "durationSec": 1.438
    },
    {
      "index": 77,
      "text": "Again. Soft inhale.",
      "file": "c077.ogg",
      "durationSec": 2.893
    },
    {
      "index": 78,
      "text": "Longer exhale.",
      "file": "c078.ogg",
      "durationSec": 2.073
    },
    {
      "index": 79,
      "text": "Feel the body held by the ground of this imagined world.",
      "file": "c079.ogg",
      "durationSec": 5.665
    },
    {
      "index": 80,
      "text": "Inhale.",
      "file": "c080.ogg",
      "durationSec": 1.612
    },
    {
      "index": 81,
      "text": "Exhale.",
      "file": "c081.ogg",
      "durationSec": 1.554
    },
    {
      "index": 82,
      "text": "If thoughts wander, return to warmth on the skin.",
      "file": "c082.ogg",
      "durationSec": 5.679
    },
    {
      "index": 83,
      "text": "Or to cool air at the nose.",
      "file": "c083.ogg",
      "durationSec": 3.118
    },
    {
      "index": 84,
      "text": "Inhale.",
      "file": "c084.ogg",
      "durationSec": 1.552
    },
    {
      "index": 85,
      "text": "Exhale.",
      "file": "c085.ogg",
      "durationSec": 1.491
    },
    {
      "index": 86,
      "text": "Inhale.",
      "file": "c086.ogg",
      "durationSec": 1.489
    },
    {
      "index": 87,
      "text": "Exhale.",
      "file": "c087.ogg",
      "durationSec": 1.545
    },
    {
      "index": 88,
      "text": "Stay. Soften. Continue.",
      "file": "c088.ogg",
      "durationSec": 3.522
    },
    {
      "index": 89,
      "text": "Inhale.",
      "file": "c089.ogg",
      "durationSec": 1.556
    },
    {
      "index": 90,
      "text": "Exhale.",
      "file": "c090.ogg",
      "durationSec": 1.492
    },
    {
      "index": 91,
      "text": "One more easy cycle.",
      "file": "c091.ogg",
      "durationSec": 2.715
    },
    {
      "index": 92,
      "text": "Inhale.",
      "file": "c092.ogg",
      "durationSec": 1.499
    },
    {
      "index": 93,
      "text": "Exhale.",
      "file": "c093.ogg",
      "durationSec": 1.489
    },
    {
      "index": 94,
      "text": "Linger in this feeling for a few more breaths.",
      "file": "c094.ogg",
      "durationSec": 4.568
    },
    {
      "index": 95,
      "text": "Warmth. Softness. Enoughness.",
      "file": "c095.ogg",
      "durationSec": 3.991
    },
    {
      "index": 96,
      "text": "You can return to this place whenever you need it.",
      "file": "c096.ogg",
      "durationSec": 4.567
    },
    {
      "index": 97,
      "text": "It lives in your attention, not only in imagination.",
      "file": "c097.ogg",
      "durationSec": 5.851
    },
    {
      "index": 98,
      "text": "Begin to deepen the breath.",
      "file": "c098.ogg",
      "durationSec": 2.597
    },
    {
      "index": 99,
      "text": "Feel the room around you again.",
      "file": "c099.ogg",
      "durationSec": 3.237
    },
    {
      "index": 100,
      "text": "Wiggle the fingers. Soften the toes.",
      "file": "c100.ogg",
      "durationSec": 4.574
    },
    {
      "index": 101,
      "text": "When you are ready, open your eyes.",
      "file": "c101.ogg",
      "durationSec": 3.985
    },
    {
      "index": 102,
      "text": "Take one more easy breath.",
      "file": "c102.ogg",
      "durationSec": 2.478
    },
    {
      "index": 103,
      "text": "Carry this calm into whatever comes next.",
      "file": "c103.ogg",
      "durationSec": 4.042
    }
  ],
  "engine": "elevenlabs",
  "elevenVoice": "pFZP5JQG7iQjIQuC4Bku",
  "elevenLabel": "Lily",
