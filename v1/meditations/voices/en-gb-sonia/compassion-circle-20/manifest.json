      "text": "[pause:34]",
      "file": "c012.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "We will offer kindness in a widening circle.",
      "file": "c013.ogg",
      "durationSec": 4.914
    },
    {
      "index": 14,
      "text": "Phrases are invitations, not commands.",
