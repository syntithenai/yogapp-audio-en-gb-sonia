    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.205
    },
    {
      "index": 1,
      "text": "Take time to arrive.",
      "file": "c001.ogg",
      "durationSec": 2.481
