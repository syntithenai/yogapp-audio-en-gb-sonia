  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.434
    },
    {
      "index": 1,
      "text": "Find a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.68
    },
    {
      "index": 2,
      "text": "Let the hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.545
    },
    {
      "index": 3,
      "text": "Soften the eyes, or close them.",
      "file": "c003.ogg",
      "durationSec": 3.359
    },
    {
      "index": 4,
      "text": "Take a slow breath in.",
      "file": "c004.ogg",
      "durationSec": 2.543
    },
    {
      "index": 5,
      "text": "And a longer breath out.",
      "file": "c005.ogg",
      "durationSec": 2.66
    },
    {
      "index": 6,
      "text": "Start with the breath for a few cycles.",
      "file": "c006.ogg",
      "durationSec": 4.218
    },
    {
      "index": 7,
      "text": "[pause:28]",
      "file": "c007.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Now widen. Include sounds.",
      "file": "c008.ogg",
      "durationSec": 3.172
    },
    {
      "index": 9,
      "text": "Near. Far. Changing. Steady.",
      "file": "c009.ogg",
      "durationSec": 3.529
    },
    {
      "index": 10,
      "text": "[pause:28]",
      "file": "c010.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 11,
      "text": "Include sensations in the body.",
      "file": "c011.ogg",
      "durationSec": 3.879
    },
    {
      "index": 12,
      "text": "Contact points. Temperature. Soft pulse.",
      "file": "c012.ogg",
      "durationSec": 4.109
    },
    {
      "index": 13,
      "text": "[pause:28]",
      "file": "c013.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 14,
      "text": "Include the space of the room.",
      "file": "c014.ogg",
      "durationSec": 3.178
    },
    {
      "index": 15,
      "text": "Awareness like open sky.",
      "file": "c015.ogg",
      "durationSec": 3.052
    },
    {
      "index": 16,
      "text": "[pause:34]",
      "file": "c016.ogg",
      "durationSec": 34.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Thoughts may appear like weather.",
      "file": "c017.ogg",
      "durationSec": 3.465
    },
    {
      "index": 18,
      "text": "No need to chase or push them.",
      "file": "c018.ogg",
      "durationSec": 2.832
    },
    {
      "index": 19,
      "text": "Sky remains.",
      "file": "c019.ogg",
      "durationSec": 2.192
    },
    {
      "index": 20,
      "text": "[pause:45]",
      "file": "c020.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Rest in this open field.",
      "file": "c021.ogg",
      "durationSec": 3.009
    },
    {
      "index": 22,
      "text": "[pause:45]",
      "file": "c022.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Take one more easy breath.",
      "file": "c023.ogg",
      "durationSec": 2.483
    },
    {
      "index": 24,
      "text": "Wiggle the fingers.",
      "file": "c024.ogg",
      "durationSec": 2.366
    },
    {
      "index": 25,
      "text": "When you are ready, open the eyes.",
      "file": "c025.ogg",
      "durationSec": 4.111
    },
    {
      "index": 26,
      "text": "Carry a little of this with you.",
      "file": "c026.ogg",
      "durationSec": 3.008
    }
