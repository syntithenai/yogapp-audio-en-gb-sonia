{
  "id": "lakeside-dawn-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 255,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 1.438
    },
    {
      "index": 1,
      "text": "Take a comfortable seat, or lie down if that feels better.",
      "file": "c001.ogg",
      "durationSec": 5.735
    },
    {
      "index": 2,
      "text": "Let your hands rest.",
      "file": "c002.ogg",
      "durationSec": 2.772
    },
    {
      "index": 3,
      "text": "Allow your eyes to close, or soften your gaze.",
      "file": "c003.ogg",
      "durationSec": 4.916
    },
    {
      "index": 4,
      "text": "Notice the weight of your body being held.",
      "file": "c004.ogg",
      "durationSec": 4.283
    },
    {
      "index": 5,
      "text": "Take a slow breath in through the nose.",
      "file": "c005.ogg",
      "durationSec": 3.933
    },
    {
      "index": 6,
      "text": "And a longer, easier breath out.",
      "file": "c006.ogg",
      "durationSec": 3.756
    },
    {
      "index": 7,
      "text": "Again. Soft inhale.",
      "file": "c007.ogg",
      "durationSec": 2.659
    },
    {
      "index": 8,
      "text": "Gentle exhale.",
      "file": "c008.ogg",
      "durationSec": 2.426
    },
    {
      "index": 9,
      "text": "If thoughts wander, that is fine. Return to the breath.",
      "file": "c009.ogg",
      "durationSec": 6.493
    },
    {
      "index": 10,
      "text": "Picture yourself at the edge of a still lake at dawn.",
      "file": "c010.ogg",
      "durationSec": 5.963
    },
    {
      "index": 11,
      "text": "The water holds a pale silver sky.",
      "file": "c011.ogg",
      "durationSec": 3.934
    },
    {
      "index": 12,
      "text": "Cool air brushes your cheeks with a clean freshness.",
      "file": "c012.ogg",
      "durationSec": 5.5
    },
    {
      "index": 13,
      "text": "A soft ribbon of sun begins to warm your shoulders.",
      "file": "c013.ogg",
      "durationSec": 5.555
    },
    {
      "index": 14,
      "text": "Feel that warmth spreading slowly across your back.",
      "file": "c014.ogg",
      "durationSec": 5.27
    },
    {
      "index": 15,
      "text": "You step closer. Soft sand gives under your feet.",
      "file": "c015.ogg",
      "durationSec": 5.671
    },
    {
      "index": 16,
      "text": "Dip your fingertips into the water. Cool. Clear.",
      "file": "c016.ogg",
      "durationSec": 5.447
    },
    {
      "index": 17,
      "text": "Ripples travel outward and disappear.",
      "file": "c017.ogg",
      "durationSec": 3.874
    },
    {
      "index": 18,
      "text": "The breeze smells faintly of water plants and morning.",
      "file": "c018.ogg",
      "durationSec": 5.5
    },
    {
      "index": 19,
      "text": "Listen. Almost nothing. A distant bird. Your own breath.",
      "file": "c019.ogg",
      "durationSec": 5.966
    },
    {
      "index": 20,
      "text": "Sit on a smooth stone warmed just enough by the rising light.",
      "file": "c020.ogg",
      "durationSec": 6.139
    },
    {
      "index": 21,
      "text": "Feel the stone’s quiet heat beneath you.",
      "file": "c021.ogg",
      "durationSec": 3.822
    },
    {
      "index": 22,
      "text": "Feel the freshness of the air entering your lungs.",
      "file": "c022.ogg",
      "durationSec": 5.555
    },
    {
      "index": 23,
      "text": "The lake mirrors soft pink and gold.",
      "file": "c023.ogg",
      "durationSec": 3.937
    },
    {
      "index": 24,
      "text": "You watch light move across the surface like slow breathing.",
      "file": "c024.ogg",
      "durationSec": 5.793
    },
    {
      "index": 25,
      "text": "A fish rises, rings widen, then the mirror returns.",
      "file": "c025.ogg",
      "durationSec": 5.846
    },
    {
      "index": 26,
      "text": "Warmth on your closed eyelids.",
      "file": "c026.ogg",
      "durationSec": 3.239
    },
    {
      "index": 27,
      "text": "Coolness on the backs of your hands.",
      "file": "c027.ogg",
      "durationSec": 3.763
    },
    {
      "index": 28,
      "text": "Somewhere far off, a boat rope ticks once against wood.",
      "file": "c028.ogg",
      "durationSec": 5.619
    },
    {
      "index": 29,
      "text": "Then silence again, wide and kind.",
      "file": "c029.ogg",
      "durationSec": 4.28
    },
    {
      "index": 30,
      "text": "Inhale the cool morning. Exhale into the open water.",
      "file": "c030.ogg",
      "durationSec": 6.653
    },
    {
      "index": 31,
      "text": "Peace settles the way mist lifts from water — gently, completely.",
      "file": "c031.ogg",
      "durationSec": 8.163
    },
    {
      "index": 32,
      "text": "You are allowed to take up space in this quiet.",
      "file": "c032.ogg",
      "durationSec": 5.088
    },
    {
      "index": 33,
      "text": "One more breath tasting of dawn.",
      "file": "c033.ogg",
      "durationSec": 3.64
    },
    {
      "index": 34,
      "text": "Look again at the silver path of light on the water.",
      "file": "c034.ogg",
      "durationSec": 5.439
    },
    {
      "index": 35,
      "text": "Follow it with soft eyes toward the far shore.",
      "file": "c035.ogg",
      "durationSec": 4.915
    },
    {
      "index": 36,
      "text": "Trees over there are blue with distance and morning mist.",
      "file": "c036.ogg",
      "durationSec": 5.56
    },
    {
      "index": 37,
      "text": "Warmth grows a little on your shoulders as the sun climbs.",
      "file": "c037.ogg",
      "durationSec": 5.959
    },
    {
      "index": 38,
      "text": "The breeze stays fresh — lake-born and clean.",
      "file": "c038.ogg",
      "durationSec": 5.378
    },
    {
      "index": 39,
      "text": "Let that freshness rinse the mind the way light rinses the surface.",
      "file": "c039.ogg",
      "durationSec": 7.47
    },
    {
      "index": 40,
      "text": "Sit for three more breaths of warmth and cool air together.",
      "file": "c040.ogg",
      "durationSec": 6.197
    },
    {
      "index": 41,
      "text": "Now rest in the breath alone for a little while.",
      "file": "c041.ogg",
      "durationSec": 4.392
    },
    {
      "index": 42,
      "text": "Inhale slowly.",
      "file": "c042.ogg",
      "durationSec": 2.43
    },
    {
      "index": 43,
      "text": "Exhale slowly.",
      "file": "c043.ogg",
      "durationSec": 2.198
    },
    {
      "index": 44,
      "text": "Inhale.",
      "file": "c044.ogg",
      "durationSec": 1.613
    },
    {
      "index": 45,
      "text": "Exhale.",
      "file": "c045.ogg",
      "durationSec": 1.551
    },
    {
      "index": 46,
      "text": "Feel warmth wherever the body is warm.",
      "file": "c046.ogg",
      "durationSec": 4.165
    },
    {
      "index": 47,
      "text": "Feel coolness wherever the air is cool.",
      "file": "c047.ogg",
      "durationSec": 4.102
    },
    {
      "index": 48,
      "text": "Inhale.",
      "file": "c048.ogg",
      "durationSec": 1.489
    },
    {
      "index": 49,
      "text": "Exhale.",
      "file": "c049.ogg",
      "durationSec": 1.493
    },
    {
      "index": 50,
      "text": "Nowhere to go. Nothing to fix.",
      "file": "c050.ogg",
      "durationSec": 3.356
    },
    {
      "index": 51,
      "text": "Inhale.",
      "file": "c051.ogg",
      "durationSec": 1.552
    },
    {
      "index": 52,
      "text": "Exhale.",
      "file": "c052.ogg",
      "durationSec": 1.609
    },
    {
      "index": 53,
      "text": "Rest here for a few quiet breaths.",
      "file": "c053.ogg",
      "durationSec": 3.868
    },
    {
      "index": 54,
      "text": "Know that you can return to this place anytime.",
      "file": "c054.ogg",
      "durationSec": 4.976
    },
    {
      "index": 55,
      "text": "When you are ready, deepen the breath.",
      "file": "c055.ogg",
      "durationSec": 3.411
    },
    {
      "index": 56,
      "text": "Wiggle fingers and toes.",
      "file": "c056.ogg",
      "durationSec": 2.715
    },
    {
      "index": 57,
      "text": "Open your eyes softly.",
      "file": "c057.ogg",
      "durationSec": 2.773
    },
    {
      "index": 58,
      "text": "Carry a little of this peace with you.",
      "file": "c058.ogg",
      "durationSec": 3.637
    }
  ],
