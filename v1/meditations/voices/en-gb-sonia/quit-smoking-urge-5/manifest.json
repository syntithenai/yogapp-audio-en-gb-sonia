{
  "id": "quit-smoking-urge-5",
  "voiceId": "en-gb-sonia",
  "edgeVoice": "en-GB-SoniaNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 263,
  "chunks": [
    {
      "index": 0,
      "text": "Welcome.",
      "file": "c000.ogg",
      "durationSec": 2.229
    },
    {
      "index": 1,
      "text": "If an urge is here, you are in the right place.",
      "file": "c001.ogg",
      "durationSec": 3.634
    },
    {
      "index": 2,
      "text": "You do not need to fight it or feed it.",
      "file": "c002.ogg",
      "durationSec": 3.274
    },
    {
      "index": 3,
      "text": "Find a steady seat, or stand with both feet on the ground.",
      "file": "c003.ogg",
      "durationSec": 4.551
    },
    {
      "index": 4,
      "text": "Soften the eyes, or keep a soft gaze.",
      "file": "c004.ogg",
      "durationSec": 3.778
    },
    {
      "index": 5,
      "text": "Take a slow breath in.",
      "file": "c005.ogg",
      "durationSec": 2.663
    },
    {
      "index": 6,
      "text": "And a longer breath out.",
      "file": "c006.ogg",
      "durationSec": 2.416
    },
    {
      "index": 7,
      "text": "[pause:12]",
      "file": "c007.ogg",
      "durationSec": 12.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Name what is happening, simply.",
      "file": "c008.ogg",
      "durationSec": 2.935
    },
    {
      "index": 9,
      "text": "An urge is present.",
      "file": "c009.ogg",
      "durationSec": 2.276
    },
    {
      "index": 10,
      "text": "It is a wave in the body and mind.",
      "file": "c010.ogg",
      "durationSec": 3.39
    },
    {
      "index": 11,
      "text": "It is not a command.",
      "file": "c011.ogg",
      "durationSec": 2.234
    },
    {
      "index": 12,
      "text": "[pause:14]",
      "file": "c012.ogg",
      "durationSec": 14.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Notice where you feel it.",
      "file": "c013.ogg",
      "durationSec": 2.792
    },
    {
      "index": 14,
      "text": "Chest. Throat. Hands. Restlessness.",
      "file": "c014.ogg",
      "durationSec": 3.309
    },
    {
      "index": 15,
      "text": "No need to make it bigger. Just locate it.",
      "file": "c015.ogg",
      "durationSec": 3.306
    },
    {
      "index": 16,
      "text": "[pause:16]",
      "file": "c016.ogg",
      "durationSec": 16.0,
      "silence": true
    },
    {
      "index": 17,
      "text": "Breathe into that place.",
      "file": "c017.ogg",
      "durationSec": 2.67
    },
    {
      "index": 18,
      "text": "Inhale soft space.",
      "file": "c018.ogg",
      "durationSec": 2.508
    },
    {
      "index": 19,
      "text": "Exhale without acting.",
      "file": "c019.ogg",
      "durationSec": 2.554
    },
    {
      "index": 20,
      "text": "[pause:16]",
      "file": "c020.ogg",
      "durationSec": 16.0,
      "silence": true
    },
    {
      "index": 21,
      "text": "Urges rise, crest, and fall.",
      "file": "c021.ogg",
      "durationSec": 3.053
    },
    {
      "index": 22,
      "text": "You are the shore. The wave moves through.",
      "file": "c022.ogg",
      "durationSec": 3.112
    },
    {
      "index": 23,
      "text": "[pause:18]",
      "file": "c023.ogg",
      "durationSec": 18.0,
      "silence": true
    },
    {
      "index": 24,
      "text": "If the mind offers a story about needing a cigarette, thank it and return.",
      "file": "c024.ogg",
      "durationSec": 5.747
    },
    {
      "index": 25,
      "text": "Return to the breath.",
      "file": "c025.ogg",
      "durationSec": 2.589
    },
    {
      "index": 26,
      "text": "Return to the feet on the floor.",
      "file": "c026.ogg",
      "durationSec": 2.844
    },
    {
      "index": 27,
      "text": "[pause:16]",
      "file": "c027.ogg",
      "durationSec": 16.0,
      "silence": true
    },
    {
      "index": 28,
      "text": "Silently, if it helps.",
      "file": "c028.ogg",
      "durationSec": 2.473
    },
    {
      "index": 29,
      "text": "This is temporary.",
      "file": "c029.ogg",
      "durationSec": 2.427
    },
    {
      "index": 30,
      "text": "I can ride this without smoking.",
      "file": "c030.ogg",
      "durationSec": 2.833
    },
    {
      "index": 31,
      "text": "[pause:18]",
      "file": "c031.ogg",
      "durationSec": 18.0,
      "silence": true
    },
    {
      "index": 32,
      "text": "Again. Soft inhale.",
      "file": "c032.ogg",
      "durationSec": 2.473
    },
    {
      "index": 33,
      "text": "Longer exhale.",
      "file": "c033.ogg",
      "durationSec": 1.921
    },
    {
      "index": 34,
      "text": "[pause:16]",
      "file": "c034.ogg",
      "durationSec": 16.0,
      "silence": true
    },
    {
      "index": 35,
      "text": "Notice any easing, even a little.",
      "file": "c035.ogg",
      "durationSec": 3.444
    },
    {
      "index": 36,
      "text": "Or notice that you stayed with yourself.",
      "file": "c036.ogg",
      "durationSec": 2.987
    },
    {
      "index": 37,
      "text": "Both count.",
      "file": "c037.ogg",
      "durationSec": 2.229
    },
    {
      "index": 38,
      "text": "[pause:16]",
      "file": "c038.ogg",
      "durationSec": 16.0,
      "silence": true
    },
    {
      "index": 39,
      "text": "You are a non-smoker meeting an old echo.",
      "file": "c039.ogg",
      "durationSec": 4.064
    },
    {
      "index": 40,
      "text": "The urge can visit. It cannot own you.",
      "file": "c040.ogg",
      "durationSec": 3.274
    },
    {
      "index": 41,
      "text": "[pause:14]",
      "file": "c041.ogg",
      "durationSec": 14.0,
      "silence": true
    },
    {
      "index": 42,
      "text": "Take one more easy breath.",
      "file": "c042.ogg",
      "durationSec": 2.786
    },
    {
      "index": 43,
      "text": "Wiggle the fingers.",
      "file": "c043.ogg",
      "durationSec": 2.466
    },
    {
      "index": 44,
      "text": "When you are ready, open the eyes.",
      "file": "c044.ogg",
      "durationSec": 2.868
    },
    {
      "index": 45,
      "text": "Continue your day free.",
      "file": "c045.ogg",
      "durationSec": 2.634
    }
  ],
  "engine": "indextts"
}
